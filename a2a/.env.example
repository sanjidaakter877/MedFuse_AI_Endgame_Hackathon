# ── Google Gemini (required) ──────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_GENAI_API_KEY=your-google-api-key-here
# Set to true if using Vertex AI instead of Google AI Studio
GOOGLE_GENAI_USE_VERTEXAI=false

# ── Groq (fallback LLM if Gemini quota is exceeded) ───────────────────────────
GROQ_API_KEY=your-groq-api-key-here

# ── A2A API key auth ──────────────────────────────────────────────────────────
API_KEY_PRIMARY=medfuse-dev-key-primary
API_KEY_SECONDARY=medfuse-dev-key-secondary

# ── FHIR context extension URI (must match Prompt Opinion workspace setting) ──
FHIR_EXTENSION_URI=https://app.promptopinion.ai/schemas/a2a/v1/fhir-context

# ── Agent public URLs (used in agent cards for Prompt Opinion to call back) ───
ORCHESTRATOR_URL=http://localhost:3100
MEDICATION_AGENT_URL=http://localhost:3101
LAB_AGENT_URL=http://localhost:3102
CARE_GAP_AGENT_URL=http://localhost:3103
